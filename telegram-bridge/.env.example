PORT=3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Dari Outstand dashboard → API Keys (bukan teks contoh di bawah!)
OUTSTAND_API_KEY=
# Salin dari backend/.env (variabel sama: GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Spreadsheet laporan (ID dari URL /d/INI/edit)
GOOGLE_SPREADSHEET_ID=1upvIUPf8M-YBwy6UcsrFtszIFT2iDwpLGcAdYIc0ofA
# Tab otomatis per tanggal (YYYY-MM-DD, TZ di bawah). GOOGLE_SHEET_TAB hanya untuk sheet auto-create.
# Email Anda agar sheet auto-create bisa dibuka di browser:
# GOOGLE_SHEET_SHARE_EMAIL=you@gmail.com

# Drive — tidak wajib. Setiap hari Anda paste link baru ke bot (/publish lalu kirim link).
# GOOGLE_DRIVE_PARENT_FOLDER_ID=  (opsional, legacy)

# Waktu Indonesia (WIB) — dipakai tab harian & kolom Waktu (WIB) di Sheets
TZ=Asia/Jakarta

# Google Service Account — same file as spreadsheet-analyzer
GOOGLE_SERVICE_ACCOUNT_PATH=C:/projects/spreadsheet-analyzer/service_account.json

# Gambar → video + musik (YouTube, Instagram, Threads, Facebook) — butuh ffmpeg
# Taruh MP3 apa saja di assets/audio/ (nama bebas)
# IMAGE_TO_VIDEO_AUDIO_PATH=C:/smm-pro-faza-main/telegram-bridge/assets/audio/lagu.mp3
# IMAGE_TO_VIDEO_DURATION_SEC=15
# IMAGE_TO_VIDEO_NETWORKS=youtube,instagram,threads,facebook
# IMAGE_TO_VIDEO_ALLOW_SILENT=true
# YOUTUBE_PUBLISH_AS_SHORTS=true
# Perkiraan upload/hari satu GCP project (teks bot saja, default ~100). Bukan per akun.
# YOUTUBE_PROJECT_UPLOADS_PER_DAY=100
# Hitung "sesi lagi" di /kuota (default ig/fb 25, yt 8)
# QUOTA_DEFAULT_BATCH_SIZE=25
# QUOTA_YOUTUBE_BATCH_SIZE=8
# QUOTA_BATCH_BY_NETWORK={"instagram":30,"youtube":8}
# OUTSTAND_ACCOUNT_LIMIT=500
# Batch besar: timeout handler Telegram & polling (ms)
# TELEGRAM_HANDLER_TIMEOUT_MS=600000
# PUBLISH_LARGE_BATCH_THRESHOLD=40
# PUBLISH_LARGE_BATCH_POLL_MS=120000
# FFMPEG_PATH=C:/Users/User/AppData/Local/Microsoft/WinGet/Packages/.../bin/ffmpeg.exe

# Durasi video per platform (detik), JSON:
# IMAGE_TO_VIDEO_DURATION_BY_NETWORK={"youtube":30,"instagram":15,"threads":12}
# MAX_DRIVE_FILE_MB=80
# DAILY_SUMMARY_ENABLED=true
# DAILY_SUMMARY_HOUR=22

# Refresh otomatis tab Sheets hari ini dari Outstand (menit). Status Gagal→Live ikut update.
# SHEET_AUTO_REFRESH_MINUTES=20

# TELEGRAM_ALLOWED_CHAT_IDS=
# OUTSTAND_WEBHOOK_SECRET=
# GOOGLE_SHEET_TAB=Sheet1
# OUTSTAND_ACCOUNT_BATCH_SIZE=50
