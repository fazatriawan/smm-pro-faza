# ================================
# SMM PRO - Environment Variables
# ================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
# Development (MongoDB Local)
MONGODB_URI=mongodb://localhost:27017/smm_pro

# Production (MongoDB Atlas)
# MONGODB_URI_ATLAS=mongodb+srv://user:pass@cluster0.xxx.mongodb.net/smm-pro?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=your_very_long_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ---- GEMINI AI ----
GEMINI_API_KEY=your_gemini_api_key_here

# ---- YOUTUBE (Google API) ----
# https://console.cloud.google.com → Enable YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback

# ---- INSTAGRAM & FACEBOOK (Meta) ----
# https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/auth/meta/callback

# ---- X / TWITTER ----
# https://developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:5000/api/auth/twitter/callback

# ---- TIKTOK ----
# https://developers.tiktok.com
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:5000/api/auth/tiktok/callback
TIKTOK_WEB_REDIRECT_URI=http://localhost:5000/api/auth/tiktok/callback

# ---- THREADS ----
# https://developers.facebook.com/apps
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:5000/api/auth/threads/callback

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600
